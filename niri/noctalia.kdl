layout {

    focus-ring {
        active-color   "#a7d475"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#a7d475"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#a7d475"
        inactive-color "#2d5000"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#a7d47580"
    }
}

recent-windows {
    highlight {
        active-color "#a7d475"
        urgent-color "#ffb4ab"
    }
}
